{
  "name": "@traceops/demo-service",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Demo shop that emits the telemetry in docs/contracts/telemetry.md and fails on command (S1 pool_leak, S2 cpu_burn).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --require ./dist/otel.js ./dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "load": "tsx load/cli.ts",
    "scenario": "npm run build && tsx scripts/run-scenario.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "~0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "~0.301.2",
    "@opentelemetry/instrumentation-express": "~0.73.0",
    "@opentelemetry/instrumentation-http": "~0.301.2",
    "@opentelemetry/instrumentation-pg": "~0.78.0",
    "@opentelemetry/instrumentation-pino": "~0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "~0.38.0",
    "@opentelemetry/resources": "~3.1.1",
    "@opentelemetry/sdk-logs": "~3.1.1",
    "@opentelemetry/sdk-metrics": "~3.1.1",
    "@opentelemetry/sdk-node": "~0.301.2",
    "express": "~5.3.0",
    "pg": "~8.23.1",
    "pino": "~10.4.0"
  },
  "devDependencies": {
    "@traceops/contracts": "*",
    "@types/express": "~5.0.6",
    "@types/node": "~26.6.6",
    "@types/pg": "~8.15.6",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2",
    "vitest": "~5.1.0"
  }
}
