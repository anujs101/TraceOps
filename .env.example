# Copy to .env (gitignored) and fill in. Never commit real values.
# Contracts v1.1: docs/contracts/environment.md §4 and §6

# --- LLM (TraceOps) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
# API host only; groq-sdk appends /openai/v1 itself
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
# GROQ_REASONING_EFFORT=low

# --- TraceOps ---
TRACEOPS_DATABASE_URL=postgres://traceops:traceops@localhost:5432/traceops
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# --- demo-service ---
DATABASE_URL=postgres://demo:demo@localhost:5432/demo
FAULT=none
SERVICE_VERSION=1.0.0
